<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PalNumbers</AssemblyName>
    <RootNamespace>PalNumbers</RootNamespace>
  </PropertyGroup>

  <!-- Destino de produção: "dotnet publish -c Release" cai em Producao/ na
       raiz do projeto. Passar -o na linha de comando continua mandando para
       onde se quiser, porque a propriedade global vence esta. -->
  <PropertyGroup>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)/Producao/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- O script de esquema acompanha o executável: é ele que cria o banco de
       trabalho na primeira execução. -->
  <ItemGroup>
    <None Update="Database/Esquema.sql">
      <Link>Esquema.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Mantém, na raiz do projeto e junto do script, um banco com o esquema
       aplicado. O banco de trabalho fica ao lado do executável e não é tocado
       aqui — é o que faz o progresso sobreviver a uma recompilação. -->
  <Target Name="PrepararBancoDoProjeto" AfterTargets="Build">
    <Exec Command="&quot;$(TargetDir)$(TargetName).exe&quot; --criar-banco &quot;$(MSBuildProjectDirectory)/Database/PalNumbers.db&quot;" />
  </Target>

  <!-- Garante o banco ao lado do executável publicado. Aplicar o esquema é
       idempotente, então republicar por cima de uma pasta de produção em uso
       atualiza os binários sem tocar nos dados já gravados. -->
  <Target Name="PrepararBancoDeProducao" AfterTargets="Publish">
    <Exec Command="&quot;$(PublishDir)$(TargetName).exe&quot; --criar-banco &quot;$(PublishDir)PalNumbers.db&quot;" />
  </Target>

</Project>
