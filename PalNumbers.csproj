<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PalNumbers</AssemblyName>
    <RootNamespace>PalNumbers</RootNamespace>
  </PropertyGroup>

  <!-- Production target: "dotnet publish -c Release" lands in Producao/ at the
       project root. Passing -o on the command line still sends it anywhere you
       like, because the global property wins over this one. -->
  <PropertyGroup>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)/Producao/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- The schema script travels with the executable: it is what creates the
       working database on the first run. -->
  <ItemGroup>
    <None Update="Database/Schema.sql">
      <Link>Schema.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Keeps a database with the schema applied in the project root, next to the
       script. The working database lives beside the executable and is not
       touched here — that is what lets progress survive a rebuild. -->
  <Target Name="PrepareProjectDatabase" AfterTargets="Build">
    <Exec Command="&quot;$(TargetDir)$(TargetName).exe&quot; --create-db &quot;$(MSBuildProjectDirectory)/Database/PalNumbers.db&quot;" />
  </Target>

  <!-- Ensures the database next to the published executable. Applying the
       schema is idempotent, so publishing over a production folder in use
       updates the binaries without touching the data already stored. -->
  <Target Name="PrepareProductionDatabase" AfterTargets="Publish">
    <Exec Command="&quot;$(PublishDir)$(TargetName).exe&quot; --create-db &quot;$(PublishDir)PalNumbers.db&quot;" />
  </Target>

</Project>
